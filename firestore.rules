rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open read and write for all store collections so orders, inbox messages, reviews,
    // products, banners, and administration data are saved and synced in real-time.

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /customer_messages/{messageId} {
      allow read, write: if true;
    }

    match /support_threads/{threadId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /banners/{bannerId} {
      allow read, write: if true;
    }

    match /hero_slides/{slideId} {
      allow read, write: if true;
    }

    match /coupons/{couponCode} {
      allow read, write: if true;
    }

    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    match /inventory_adjustments/{adjustmentId} {
      allow read, write: if true;
    }

    match /delivery_personnel/{personnelId} {
      allow read, write: if true;
    }

    match /delivery_assignments/{assignmentId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /user_permissions/{permissionId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    // Default match for any subcollections or nested paths
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
