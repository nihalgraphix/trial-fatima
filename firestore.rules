rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email.matches('.*admin.*') // Fallback for bootstrap
      );
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }

    // User Profile Validation
    function isValidUser(data) {
      return (data.role == null || data.role in ['customer', 'admin', 'delivery']) &&
             (data.email == null || data.email is string);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && incoming().role == 'customer';
      allow update: if (isOwner(userId) || isAdmin()) && (
        // Prevent role escalation for regular users
        (isAdmin() || (incoming().role == existing().role || !('role' in incoming())))
      );
    }
    
    match /orders/{orderId} {
      allow read: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /supportThreads/{threadId} {
      allow read: if isSignedIn() && (isOwner(existing().customerId) || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin() || isOwner(existing().customerId);
    }

    match /customerMessages/{messageId} {
      allow read, list: if isAdmin();
      allow create: if true; // Public contact form
      allow update, delete: if isAdmin();
    }

    // Public catalog data (if migrated to Firestore)
    match /products/{id} { allow read: if true; }
    match /categories/{id} { allow read: if true; }
    match /banners/{id} { allow read: if true; }
    match /reviews/{id} { 
      allow read: if true;
      allow create: if isSignedIn();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
