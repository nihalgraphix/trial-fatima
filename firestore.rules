rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create, update: if isValidId(userId);
      allow delete: if isValidId(userId);
    }

    // --- Products & Catalog ---
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isValidId(categoryId);
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isValidId(bannerId);
    }

    match /hero_slides/{slideId} {
      allow read: if true;
      allow write: if isValidId(slideId);
    }

    match /coupons/{couponCode} {
      allow read: if true;
      allow write: if isValidId(couponCode);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isValidId(reviewId);
    }

    // --- Orders & Transactions ---
    match /orders/{orderId} {
      allow read: if isValidId(orderId);
      allow write: if isValidId(orderId);
    }

    // --- Support & Live Chat ---
    match /support_threads/{threadId} {
      allow read, write: if isValidId(threadId);
    }

    match /customer_messages/{messageId} {
      allow read, write: if isValidId(messageId);
    }

    // --- Store Operations & Logistics ---
    match /expenses/{expenseId} {
      allow read, write: if isValidId(expenseId);
    }

    match /inventory_adjustments/{adjustmentId} {
      allow read, write: if isValidId(adjustmentId);
    }

    match /delivery_personnel/{personnelId} {
      allow read, write: if isValidId(personnelId);
    }

    match /delivery_assignments/{assignmentId} {
      allow read, write: if isValidId(assignmentId);
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    // --- Connection Test ---
    match /test/connection {
      allow read: if true;
    }
  }
}
